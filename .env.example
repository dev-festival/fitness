# Local use works without configuration. Required for any hosted deployment:
APP_PASSWORD=
# Generate a random secret of at least 32 characters.
SESSION_SECRET=
# Local default: file:data/steady.db. Vercel requires a remote libsql:// URL.
DATABASE_URL=file:data/steady.db
DATABASE_AUTH_TOKEN=
# Optional. AI is disabled until configured; never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional separate vision/structured-output model for food and journal analysis.
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
